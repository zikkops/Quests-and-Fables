rules_version = '2';

/*
  Quests & Fables, Firestore security rules.

  README rule 6 was written for Supabase and says: write every policy in the
  same migration as its table, because a missing policy is a public data leak.
  Firestore is worse in one specific way, so the rule is stricter here. Postgres
  denies by default until you grant; Firestore denies by default too, but a
  single over-broad `match /{document=**}` written by somebody in a hurry opens
  the entire database. There is exactly one wildcard in this file and it is the
  final deny.

  What this file protects:

  1. **A profile is readable by its owner and nobody else.** It holds a phone
     number and where somebody lives. There is no public profile document yet,
     and when there is one it will be a separate collection with the private
     fields left out, never a rule that relaxes this one.

  2. **A username is claimed once and cannot be edited.** `usernames/{lower}`
     is a lock: creatable only by the person taking it, never updatable,
     never deletable through the client. Creating a profile requires holding the
     matching lock in the same transaction, so the lock cannot be bypassed by
     writing a profile on its own.

  3. **The party's record and the game master's book are one collection with
     two audiences.** Players write the first and cannot read the second; the
     game master reads both and writes only their own. Enforced on every note.

  4. **Five characters, enforced here rather than trusted from the client.**
     Rules cannot count a collection, so the count is a field on the profile.
     `getAfter()` checks that a create and its increment happen in one batch,
     and a decrement has to name the document it removed so the rule can see
     that document existed before and is gone after. Neither half is optional:
     without the first the counter never rises, without the second it can be
     wound back to zero for free and the limit means nothing.

  **Every rule in this file is tested.** `npm run test:rules` runs 126 cases
  against the emulator. Each one is what somebody with the SDK and a text
  editor can do, rather than what the app happens to do, because the app being
  well behaved is not evidence. Run it before deploying: a rules mistake does
  not throw, it quietly opens something.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /*
      An admin is a custom claim on the account, set with the Admin SDK from a
      script somebody runs on their own machine. It cannot be granted from a
      browser, it is not a field in this database, and nothing a player can
      write reaches it.

      Note what admin does and does not buy. It reads profiles, because running
      this means calling players and putting parties together. It does not read
      a party's notebook. Rule 9 has no admin exception: the record is the
      table's, and whoever runs the service is not at the table.
    */
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    /*
      The seven day clock on an unconfirmed address.

      A password signup cannot prove the email, so a new account runs on trust
      for a week and is then held: it still reads, and it writes nothing until
      the link is followed. Enforced here rather than only on screen, because a
      rule that lives in a component is a suggestion.

      `email_verified` is a claim on the token and nothing in this database can
      set it. 604800000 is seven days in milliseconds.
    */
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function inGoodStanding(uid) {
      return verified()
             || request.time.toMillis() < profileNow(uid).createdAt + 604800000;
    }

    function profileNow(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    function profileAfter(uid) {
      return getAfter(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    /* ---- usernames: a lock, not a record ---------------------------------
       The document id is the lowercased username. Its existence is what makes
       the name taken. Creating one is how you claim it, and there is no path
       that lets you release or steal one from the client.
       -------------------------------------------------------------------- */
    match /usernames/{name} {
      // Readable so the sign-up form can say "taken" before you submit.
      allow read: if true;

      allow create: if isOwner(request.resource.data.uid)
                    && request.resource.data.keys().hasOnly(['uid'])
                    && name.size() >= 3
                    && name.size() <= 20
                    && name.matches('^[a-z0-9_]+$');

      allow update, delete: if false;
    }

    /* ---- profiles: private, and the username is immutable ---------------- */
    match /profiles/{uid} {
      // The owner, and whoever runs the service. A phone number is on this
      // document, so this is the widest read in the file and it is deliberate:
      // a party cannot be assembled by somebody who cannot see who is waiting.
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.area is string
                    && request.resource.data.characterCount == 0
                    // Thirteen years in milliseconds, near enough. The floor is
                    // for holding an account; the in-person age policy is a
                    // separate and still open question.
                    && request.resource.data.dob is int
                    && request.time.toMillis() - request.resource.data.dob >= 410000000000
                    && request.resource.data.week is list
                    && request.resource.data.week.size() == 7
                    // The lock and the profile are one act. Without this, the
                    // profile create never consults usernames/ at all, and a
                    // second player could write a profile carrying a name
                    // somebody else holds — the lock would be intact and the
                    // uniqueness it exists for would not.
                    && getAfter(
                         /databases/$(database)/documents/usernames/$(request.resource.data.username)
                       ).data.uid == uid;

      allow update: if (isOwner(uid) || isAdmin())
                    // Nothing outside this list may appear on a profile. Without
                    // it an update is an open document: a player could add
                    // fields of their own choosing to a record the admin console
                    // renders, and the fields protected one by one below are
                    // only protected because somebody remembered to name them.
                    // A whitelist fails closed; a blacklist fails silently.
                    && request.resource.data.keys().hasOnly([
                         'uid', 'username', 'email', 'phone', 'dob', 'area',
                         'playAreas', 'week', 'venues', 'limits',
                         'characterCount', 'gm', 'createdAt', 'updatedAt',
                         'removed', 'style', 'experience', 'languages'
                       ])
                    // The seven day clock. Written out rather than calling
                    // inGoodStanding(), because on an update the profile is
                    // already in hand and there is no sense paying for a get()
                    // to read a field sitting right there.
                    && (isAdmin()
                        || verified()
                        || request.time.toMillis() < resource.data.createdAt + 604800000)
                    // ...and the clock cannot be wound back. `createdAt` is what
                    // the grace period is measured against, so leaving it
                    // writable let an unverified account refresh its own week
                    // before the week ran out, forever. The check above reads
                    // the stored value, so an expired account cannot update at
                    // all — but an account still inside its week could have kept
                    // itself there indefinitely and never confirmed an address.
                    && (isAdmin()
                        || request.resource.data.createdAt == resource.data.createdAt)
                    // Permanent, and not by accident: the request has to carry
                    // the same username it already had.
                    && request.resource.data.username == resource.data.username
                    // A mistyped birthday is an admin's job to fix, not a thing
                    // to be edited quietly on the way into an adults-only table.
                    // get() with a default, so a profile written before dates of
                    // birth existed does not make this rule throw.
                    && (isAdmin()
                        || request.resource.data.get('dob', 0)
                           == resource.data.get('dob', 0))
                    // Only an admin marks somebody a game master. They are
                    // recruited and met in person; self-promotion is not a
                    // route into other people's evenings.
                    && (isAdmin() || request.resource.data.get('gm', false)
                                     == resource.data.get('gm', false))
                    && request.resource.data.uid == resource.data.uid
                    /*
                      A decrement has to prove a deletion.

                      The counter is the limit's only enforcement point, because
                      rules cannot count a collection. That made it the weak
                      point too: a create must increment it, and a delete must
                      decrement it, but for a while nothing required a decrement
                      to be *accompanied* by a delete. Five characters, five bare
                      profile writes taking the counter back to zero, five more
                      characters, repeat. The client never did it; the SDK is
                      right there for anybody who wants to.

                      So a write that lowers the counter has to name the document
                      it removed, and that document has to have existed before
                      and be gone after. Naming one that never existed fails the
                      first half; naming one and not deleting it fails the
                      second. A write that does not lower the counter never
                      evaluates any of this.
                    */
                    && (
                         request.resource.data.characterCount
                           >= resource.data.characterCount
                         || (
                              exists(/databases/$(database)/documents/profiles/$(uid)/characters/$(request.resource.data.removed))
                              && !existsAfter(/databases/$(database)/documents/profiles/$(uid)/characters/$(request.resource.data.removed))
                            )
                       )
                    // The counter is the limit's only enforcement point, so it
                    // may only ever move by one, and only inside the range.
                    && request.resource.data.characterCount >= 0
                    && request.resource.data.characterCount <= 5
                    && (
                         request.resource.data.characterCount == resource.data.characterCount
                         || request.resource.data.characterCount == resource.data.characterCount + 1
                         || request.resource.data.characterCount == resource.data.characterCount - 1
                       );

      // Deleting an account is a real operation with real cleanup behind it,
      // so it does not happen from a browser. It will be a callable function.
      allow delete: if false;

      /* ---- characters: five, and the count has to agree ------------------
         A create is only allowed when the profile's counter goes up by one in
         the same batch, and a delete only when it goes down by one. That is
         what makes the limit real rather than a number the form checks.
         ------------------------------------------------------------------ */
      match /characters/{characterId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
                      && inGoodStanding(uid)
                      && request.resource.data.ownerId == uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 60
                      && request.resource.data.kind in ['srd', 'custom']
                      && profileNow(uid).characterCount < 5
                      && profileAfter(uid).characterCount == profileNow(uid).characterCount + 1;

        allow update: if isOwner(uid)
                      && request.resource.data.ownerId == uid
                      && request.resource.data.kind == resource.data.kind;

        allow delete: if isOwner(uid)
                      && profileAfter(uid).characterCount == profileNow(uid).characterCount - 1;
      }
    }

    /* ---- parties, and the notebook under them ----------------------------
       Two books under one session, and the difference between them is the
       whole feature:

         book == 'party'  every player writes, the game master only reads
         book == 'gm'     the game master alone, and players cannot read it

       The party's record is theirs. A game master who could edit it could
       quietly correct what the table believes happened, and what the table
       believes happened is the only thing the record is for. Their own book is
       the other half of the bargain: somewhere to write down the thing the
       party has not worked out yet.

       Note the read rule on notes. Firestore rules are not filters — a query
       is allowed only if the rules can see it cannot return a forbidden
       document, which is why every read here goes through a query carrying
       'where book == ...' and why players are refused the whole collection
       unless they ask for the party book by name.
       -------------------------------------------------------------------- */
    match /parties/{partyId} {

      function member() {
        return get(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)).data;
      }

      function memberRole() {
        return signedIn() ? member().role : '';
      }

      /*
        A party is assembled by whoever runs the service, not by its players.
        Game masters are recruited and met in person (see the README), and a
        party of the wrong size or with a stranger's game master is not a thing
        a browser should be able to make.

        The size limits are here rather than only in the console, because the
        console is a form and a form is a suggestion. README rule 7: four to
        six, and the game master is not one of them.
      */
      /*
        Readable by anybody at all, signed in or not.

        This is not laziness, it is the product: the homepage promises you can
        browse every open table without an account, and `signedIn()` here would
        have made that promise false the moment the rules were deployed. Caught
        by pointing the finished site at the real database and watching a
        signed-out visitor get "Missing or insufficient permissions".

        The price is that this document is public, so what may live on it is
        strictly limited: a name, an area, a status, opaque uids, an hour, and
        the `profile` aggregate. No phone numbers, no addresses, nothing
        belonging to one member. The aggregate exists precisely so a table can
        say what hours it shares and what it will not play through without
        saying which of the four said so. The group chat link is one document
        deeper, in secrets/, for the same reason.

        What that means for what may live on this document: no phone numbers,
        no addresses, and nothing belonging to one member. The `profile` field
        is a deliberate aggregate for exactly this reason — it says what hours
        this table shares and what it will not play through, and never which of
        the four said so. The group chat link moved to secrets/ below on the
        same argument: rules cannot hide one field of a readable document.
      */
      allow read: if true;

      function namedSanely() {
        return request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.name.size() <= 60
               && request.resource.data.area is string;
      }

      allow create: if isAdmin()
                    && request.resource.data.playerIds is list
                    && request.resource.data.playerIds.size() <= 6
                    && namedSanely()
                    && request.resource.data.status in ['forming', 'assigned', 'playing', 'closed'];

      /*
        A group of friends founding their own table.

        Everything a player may not do is spelled out rather than assumed: they
        start alone, they are the founder, there is no game master, and the
        party is private. `open == false` is the load-bearing one. An open party
        enters matching and is offered to strangers, and a party a player could
        open would be a party a player could use to reach strangers on our
        recommendation. Game masters stay out of a player's hands for the
        reason /join gives: they are recruited and met in person.
      */
      allow create: if signedIn()
                    && inGoodStanding(request.auth.uid)
                    && namedSanely()
                    && request.resource.data.founderId == request.auth.uid
                    && request.resource.data.playerIds == [request.auth.uid]
                    && request.resource.data.gmId == null
                    && request.resource.data.open == false
                    && request.resource.data.status == 'forming'
                    && request.resource.data.slot == null;

      /*
        A founder taking on a friend who asked.

        The link to a private party is an invitation, not an authorisation:
        anybody holding it may ask, and only the founder may say yes. That is
        why this rule proves the ask happened rather than trusting the founder
        to have a reason — a founder who could add any uid could put somebody
        at a table without their consent, and a seat at a table is a room with
        strangers in it.

        The request id is the pair, which is the only reason a rule can find it
        at all: get() on a known id is the only lookup rules have.
      */
      function askedFor(uid) {
        return get(
                 /databases/$(database)/documents/seatRequests/$(uid + '_' + partyId)
               ).data.status == 'waiting';
      }

      allow update: if signedIn()
                    && resource.data.get('founderId', '') == request.auth.uid
                    && resource.data.get('open', true) == false
                    // Only the roster moves, and only by one, and only towards
                    // somebody who asked.
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['playerIds', 'updatedAt'])
                    && request.resource.data.playerIds.size()
                       == resource.data.playerIds.size() + 1
                    && request.resource.data.playerIds.size() <= 6
                    // Nobody already there is dropped on the way in.
                    && request.resource.data.playerIds.hasAll(resource.data.playerIds)
                    && askedFor(
                         request.resource.data.playerIds
                           .removeAll(resource.data.playerIds)[0]);

      /*
        A game master removing one player from their own party, and nothing
        else. `/safety` promises they can do it immediately and without
        explaining themselves first, so it cannot be a request to an admin who
        might be asleep.

        Every clause here is load bearing. The affected keys are a whitelist, so
        this cannot rename the party, move it, or hand it to somebody else. The
        list must shrink by exactly one and every remaining id must have been
        there already, so it removes rather than replaces: without `hasOnly`
        a game master could swap the table for five accounts of their own.
        `gmId` is not in the whitelist, so it cannot change under this clause
        at all, which is what stops a game master promoting themselves out of a
        party they were removed from.
      */
      function gmRemovingOnePlayer() {
        return signedIn()
               && memberRole() == 'gm'
               && resource.data.gmId == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['playerIds', 'status', 'profile', 'updatedAt'])
               && request.resource.data.playerIds.size() == resource.data.playerIds.size() - 1
               && request.resource.data.playerIds.hasOnly(resource.data.playerIds);
      }

      /*
        A game master starting the first night, and nothing else.

        `status` is the field that says a party has played, and until this
        existed only an admin could set it. That made the field a lie in
        practice: a table could run for months and still read as "assigned",
        because the only person who knew a night had happened was the one person
        who could not say so. It also silently held back everything that waits
        on `playing`, the game master's rating among them.

        One transition only, in one direction. A game master cannot close a
        party, cannot walk it back to forming, and cannot touch anything else in
        the same write.
      */
      function gmStartingPlay() {
        return signedIn()
               && memberRole() == 'gm'
               && resource.data.gmId == request.auth.uid
               && resource.data.status == 'assigned'
               && request.resource.data.status == 'playing'
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'updatedAt']);
      }

      allow update: if (isAdmin() || gmRemovingOnePlayer() || gmStartingPlay())
                    && request.resource.data.playerIds is list
                    && request.resource.data.playerIds.size() <= 6
                    // A game master may only be *attached* to a party that is
                    // actually a party. Four is the floor for assigning one.
                    //
                    // It is not a floor for keeping one. A table that loses its
                    // fourth player, because somebody left or was removed, is a
                    // table of three that still has a game master and still has
                    // a campaign. Reading it the other way would have meant a
                    // game master could not remove the fourth person, which is
                    // exactly the person most worth removing.
                    && (request.resource.data.gmId == null
                        || request.resource.data.gmId == resource.data.gmId
                        || request.resource.data.playerIds.size() >= 4)
                    // The game master is never one of the players.
                    && !(request.resource.data.gmId in request.resource.data.playerIds);

      allow delete: if false;

      match /members/{uid} {
        allow read: if memberRole() in ['player', 'gm'] || isAdmin();
        allow write: if isAdmin();

        /*
          A founder seating somebody on their own roster, as a player.

          Founding a table and accepting a friend only ever wrote `playerIds`,
          and `memberRole()` reads this document rather than that list, so a
          founded table's own campaign page refused everybody at it, the founder
          included. This is the write that was missing.

          Tied to the roster, so it cannot hand a stranger the notebook: the
          roster only grows through a request that person made themselves. Role
          is 'player' and only 'player', so a founder cannot make themselves the
          game master by the back door. And the name has to be the one the
          usernames lock says belongs to this uid, because the whole table reads
          it and a founder could otherwise label anybody anything.
        */
        allow create: if signedIn()
                      && get(/databases/$(database)/documents/parties/$(partyId))
                           .data.get('founderId', '') == request.auth.uid
                      && uid in get(/databases/$(database)/documents/parties/$(partyId))
                           .data.playerIds
                      && request.resource.data.keys().hasOnly(['role', 'name'])
                      && request.resource.data.role == 'player'
                      && request.resource.data.name is string
                      && get(
                           /databases/$(database)/documents/usernames/$(request.resource.data.name)
                         ).data.uid == uid;

        /*
          This document is what `memberRole()` reads, so deleting it is what
          actually ends somebody's access to the table: the notebook, the
          sheets, the group chat link, all of it. It is the first write the
          removal makes for that reason.

          Only over a player, and only by the game master of this same party,
          because `memberRole()` is scoped to it. A game master cannot remove
          another game master, and nobody can remove themselves this way.
        */
        allow delete: if memberRole() == 'gm' && resource.data.role == 'player';
      }

      /* ---- sheets brought to the table ------------------------------------
         A member's character, copied here so the rest of the table can see it.
         Yours to bring and yours to take back; readable by everybody at this
         table and nobody else.

         This is why the characters on a profile never needed a wider read rule.
         A game master does not reach into your account: you hand them a copy.
         -------------------------------------------------------------------- */
      match /sheets/{uid} {
        allow read: if memberRole() in ['player', 'gm'];

        allow write: if request.auth.uid == uid
                     && inGoodStanding(uid)
                     && memberRole() in ['player', 'gm']
                     && (request.method == 'delete'
                         || request.resource.data.ownerId == uid);

        /*
          And the game master may delete one, which is only ever used to take a
          removed player's character off the table with them. Deletion cannot
          leak anything: a game master can already read every sheet here. The
          alternative is worse, because the owner stops being a member the
          moment they are removed and can then no longer take their own sheet
          back.
        */
        allow delete: if memberRole() == 'gm';
      }

      /* ---- the group chat, and anything else that is a key ---------------
         An invite link lets whoever holds it walk into the conversation, so it
         is not on the party document that everybody can read. Members only.
         -------------------------------------------------------------------- */
      match /secrets/{document} {
        allow read: if memberRole() in ['player', 'gm'] || isAdmin();
        allow write: if isAdmin();
      }

      /* ---- what the table agreed before it played -------------------------
         Session Zero. The tone, what everybody expects, the hard limits, the
         house rules, and what happens when one of six cannot make a Tuesday.

         **Written by players and never by the game master**, which is rule 9
         applied to an agreement rather than to a record. The reasoning is the
         same and it is not weaker here: a game master who can edit what the
         table agreed can quietly widen it, and this document is the only thing
         a player can point at afterwards. They read it, they are at the
         conversation that fills it in, and they do not hold the pen.

         Signatures are a map of uid to when that person last agreed, and
         `changedAt` moves whenever an answer does, so a signature older than
         the last edit is visibly stale rather than silently wrong. Nobody can
         sign for anybody else.
         -------------------------------------------------------------------- */
      match /sessionZero/{document} {
        allow read: if memberRole() in ['player', 'gm'];

        allow create, update: if memberRole() == 'player'
                              && inGoodStanding(request.auth.uid)
                              && request.resource.data.keys()
                                   .hasOnly(['answers', 'signed', 'changedAt', 'updatedAt'])
                              && request.resource.data.answers is map
                              && request.resource.data.signed is map
                              && request.resource.data.changedAt is int
                              && request.resource.data.updatedAt is int
                              // Sign for yourself. Whatever else this write
                              // does, it may not add or move anybody else's
                              // signature.
                              && request.resource.data.signed.diff(
                                   resource == null ? {} : resource.data.signed
                                 ).affectedKeys().hasOnly([request.auth.uid]);

        /* The agreement is not something one of six can throw away. */
        allow delete: if false;
      }

      /* ---- who was removed, and by whom -----------------------------------
         "Without explaining themselves first" is not the same as never. A
         removal leaves nothing behind otherwise, because the membership it
         ended is deleted, so this is the only trace that it happened.

         Not readable by the rest of the table. It names one person and says
         they were thrown out, which is exactly the sort of thing rule 8 keeps
         off a document five other people can read.
         -------------------------------------------------------------------- */
      match /removals/{uid} {
        allow read: if memberRole() == 'gm' || isAdmin();

        allow create: if memberRole() == 'gm'
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.at is int
                      && request.resource.data.keys().hasOnly(['by', 'at']);

        /* Written once. A record somebody can edit afterwards is not a record. */
        allow update, delete: if false;
      }

      // Note there is no admin clause from here down. Rule 9 has no exception:
      // the record belongs to the table, and whoever runs the service is not
      // at it. An admin can see that a party exists and who is in it. What was
      // said on a Thursday night is none of their business.
      match /sessions/{sessionId} {
        allow read: if memberRole() in ['player', 'gm'];

        /*
          Attendance, which only the game master writes.

          Two things are checked rather than trusted. The marks have to be one
          of the three, so a client cannot invent a fourth and have it counted
          as something later. And every name in the map has to be somebody
          actually at this table, because a record that can hold strangers is a
          record that can be pointed at a person who was never there.

          It is optional: a night nobody filled in is a night nobody filled in,
          and `attendanceOf` in src/lib/attendance.ts leaves those out of the
          denominator rather than counting them as absences.
        */
        /*
          Only the marks this write actually changes have to belong to somebody
          still at the table, not every mark in the map.

          Checking the whole map looked equivalent and was not. The map is
          history: once a game master removes somebody who had already been
          marked, their old entry is still in it, so every later write to that
          night failed, closing the night included, and the game master was
          locked out of their own register by a mark that was true when it was
          made. Untouched history stands. Anything new has to be a person here.
        */
        function attendanceSane() {
          return request.resource.data.get('attendance', {}).values()
                   .hasOnly(['came', 'missed', 'excused'])
                 && request.resource.data.get('attendance', {})
                      .diff(resource == null ? {} : resource.data.get('attendance', {}))
                      .affectedKeys()
                      .hasOnly(get(/databases/$(database)/documents/parties/$(partyId))
                                 .data.playerIds);
        }

        // A session is opened and closed by the game master running it.
        allow create, update: if memberRole() == 'gm'
                              && request.resource.data.number is int
                              && request.resource.data.title is string
                              && request.resource.data.title.size() <= 80
                              && request.resource.data.open is bool
                              && attendanceSane();

        allow delete: if false;

        match /notes/{noteId} {
          // A player may only ever see the party's book. The game master sees
          // both, because they read the record and keep their own.
          allow read: if memberRole() == 'gm'
                      || (memberRole() == 'player' && resource.data.book == 'party');

          allow create: if signedIn()
                        && inGoodStanding(request.auth.uid)
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.body is string
                        && request.resource.data.body.size() > 0
                        && request.resource.data.body.size() <= 2000
                        && request.resource.data.kind in ['note', 'npc', 'place', 'loot', 'question']
                        && request.resource.data.book in ['party', 'gm']
                        && (
                             // Players write the record; the game master cannot.
                             (request.resource.data.book == 'party' && memberRole() == 'player')
                             // The other book has exactly one author.
                             || (request.resource.data.book == 'gm' && memberRole() == 'gm')
                           );

          // Your own line, and never anybody else's. The book a note is in
          // cannot change, or a game master note could be moved into the
          // party's record after the fact.
          allow update: if resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.book == resource.data.book
                        && request.resource.data.body.size() > 0
                        && request.resource.data.body.size() <= 2000;

          // Deleting somebody else's note is a moderation action, not a game
          // master power, and moderation does not happen from a browser.
          allow delete: if resource.data.authorId == request.auth.uid;
        }
      }
    }

    /* ---- seat requests ---------------------------------------------------
       A player asking for a seat at a table they can see. Theirs to make and
       theirs to withdraw; nobody else's to read.

       Deliberately top level rather than under the party. A player needs "what
       have I asked for", which is a query across parties, and the alternative
       is a collection group query — which needs a match /{path=**} rule, the
       database-wide wildcard this file opens by refusing to have.
       -------------------------------------------------------------------- */
    match /seatRequests/{requestId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.playerId == request.auth.uid);

      allow create: if signedIn()
                    && inGoodStanding(request.auth.uid)
                    && request.resource.data.playerId == request.auth.uid
                    // The name on the request has to be the name that lock says
                    // belongs to this uid. A founder decides who joins their
                    // table from this field, so a client that could put any
                    // string in it could put a friend's name on a stranger.
                    && request.resource.data.playerName is string
                    && get(
                         /databases/$(database)/documents/usernames/$(request.resource.data.playerName)
                       ).data.uid == request.auth.uid
                    && request.resource.data.partyId is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500;

      // Answering a request is the service's job, not the asker's. A player
      // who changes their mind withdraws it instead.
      allow update: if isAdmin();

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.playerId == request.auth.uid);
    }

    /* ---- reports ---------------------------------------------------------
       Somebody saying that something here is wrong.

       Legal & Compliance lists this among the things that exist **before** open
       matching, not after: strangers meet in person through this, and a player
       with a bad experience needs a route inside the product rather than an
       email address and hope.

       Write-only from a player's side, which is the shape that matters. You may
       file one and read your own back; you may not read anybody else's, edit
       one after the fact, or delete one. A report that its subject could find,
       change or make disappear would be worse than no report at all, and the
       reporter cannot quietly withdraw the record either.
       -------------------------------------------------------------------- */
    match /reports/{reportId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.reporterId == request.auth.uid);

      allow create: if signedIn()
                    && inGoodStanding(request.auth.uid)
                    && request.resource.data.reporterId == request.auth.uid
                    // Reporting yourself is not a thing that needs to work.
                    && request.resource.data.targetId != request.auth.uid
                    && request.resource.data.targetId is string
                    && request.resource.data.targetKind in ['player', 'note']
                    && request.resource.data.reason in
                         ['safety', 'harassment', 'content', 'noshow', 'other']
                    && request.resource.data.detail is string
                    && request.resource.data.detail.size() <= 1000
                    && request.resource.data.status == 'open';

      // Answering one is the service's job. Nobody edits a report, including
      // the person who filed it: the record is what was said at the time.
      allow update: if isAdmin()
                    && request.resource.data.reporterId == resource.data.reporterId
                    && request.resource.data.targetId == resource.data.targetId
                    && request.resource.data.status in ['open', 'actioned', 'dismissed'];

      allow delete: if false;
    }

    /* ---- everything else ------------------------------------------------
       Everything the product does not have yet. Until each collection arrives
       with its own rules written beside it, nothing else in this database is
       reachable from a browser.
       -------------------------------------------------------------------- */
    /* ======================================================================
       What a table says about the game master who ran it

       The tally is public. That was decided with the objection on the table:
       nobody here picks their own game master, the house assigns them, so a
       public number buys a player nothing they can act on, and it attaches a
       score to a named person in a small city out of a handful of evenings.
       Public it is. These rules are what make it survivable.

       The hard problem is that a public counter written by a browser is a
       counter a browser can lie to. There is no server and no Admin SDK here,
       so it is solved the way the character limit is: the tally may only move
       in lockstep with a private rating document created in the same write, and
       the rules read that document with getAfter to check the arithmetic. A
       client cannot add two, cannot add one twice, and cannot claim a yes it
       did not give.

       Individual ratings are not public. A list of who said what is a list of
       who said what, and four players can already infer a lot from an average
       that moves. That is the honest limit of this, and why the page shows
       nothing at all until three ratings exist.
       ====================================================================== */
    match /gmRatings/{gmId} {

      function ratingAfter() {
        return getAfter(
          /databases/$(database)/documents/gmRatings/$(gmId)/ratings/$(request.auth.uid)
        ).data;
      }

      /*
        A rating is being created by this same write, and there was not one
        before. Both halves matter: without `exists` being false, somebody
        could bump the tally again and again against a rating they wrote once.
      */
      function ratingLandsNow() {
        return signedIn()
               && !exists(
                    /databases/$(database)/documents/gmRatings/$(gmId)/ratings/$(request.auth.uid)
                  )
               && existsAfter(
                    /databases/$(database)/documents/gmRatings/$(gmId)/ratings/$(request.auth.uid)
                  );
      }

      function party(partyId) {
        return get(/databases/$(database)/documents/parties/$(partyId)).data;
      }

      /*
        You may rate the game master of a table you actually played at.

        `role == 'player'` is what stops a game master rating themselves, since
        their own membership says 'gm', and rule 7 already keeps them out of
        playerIds. `status == 'playing'` is what stops a party rating somebody
        before a single evening has happened.
      */
      function playedUnder(partyId) {
        return party(partyId).gmId == gmId
               && party(partyId).status == 'playing'
               && get(
                    /databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)
                  ).data.role == 'player';
      }

      function mayRate() {
        return ratingLandsNow()
               && ratingAfter().at is int
               && playedUnder(ratingAfter().partyId);
      }

      function shape() {
        return request.resource.data.keys()
                 .hasOnly(['count', 'prepared', 'fair', 'safe', 'again', 'updatedAt'])
               && request.resource.data.updatedAt is int;
      }

      /* Public, which is the whole point and the whole risk. */
      allow read: if true;

      /* The first rating this game master has ever had. */
      allow create: if mayRate()
                    && shape()
                    && request.resource.data.count == 1
                    && request.resource.data.prepared == (ratingAfter().prepared ? 1 : 0)
                    && request.resource.data.fair == (ratingAfter().fair ? 1 : 0)
                    && request.resource.data.safe == (ratingAfter().safe ? 1 : 0)
                    && request.resource.data.again == (ratingAfter().again ? 1 : 0);

      /*
        Every later one. Exactly one more rating, and each axis moves by exactly
        what that rating said and nothing else.
      */
      allow update: if mayRate()
                    && shape()
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.prepared
                         == resource.data.prepared + (ratingAfter().prepared ? 1 : 0)
                    && request.resource.data.fair
                         == resource.data.fair + (ratingAfter().fair ? 1 : 0)
                    && request.resource.data.safe
                         == resource.data.safe + (ratingAfter().safe ? 1 : 0)
                    && request.resource.data.again
                         == resource.data.again + (ratingAfter().again ? 1 : 0);

      /* A tally nobody can clear. Deleting it would reset a person's history. */
      allow delete: if false;

      match /ratings/{raterId} {
        /*
          Yours and the house's. Not the game master's, and not the public's:
          the tally above is the public artefact and this is the evidence under
          it. A game master who could read these could work out who said no.
        */
        allow read: if isOwner(raterId) || isAdmin();

        allow create: if isOwner(raterId)
                      && inGoodStanding(raterId)
                      && request.resource.data.keys()
                           .hasOnly(['prepared', 'fair', 'safe', 'again', 'partyId', 'at'])
                      && request.resource.data.prepared is bool
                      && request.resource.data.fair is bool
                      && request.resource.data.safe is bool
                      && request.resource.data.again is bool
                      && request.resource.data.partyId is string
                      && request.resource.data.at is int;

        /*
          Written once and it stands. A rating that can be edited is a rating
          that can be traded, and the tally above has already counted this one:
          there is no arithmetic here that could take it back.
        */
        allow update, delete: if false;
      }
    }

    /* ---- blocks -----------------------------------------------------------
       "Never put me with this person again." The last of the four things
       /safety promises.

       **Only the person who made it can read it, and an admin.** Not the
       person blocked, not ever, and that is the single most important line in
       this rule. A block somebody can discover is a block with a cost attached
       to making it, and the people most in need of one are exactly the people
       who cannot afford that cost. It is also why nothing anywhere says why a
       table was not offered.

       Top level rather than under a profile, for the same reason seat requests
       are: matching has to ask "every block that exists" and the alternative is
       a collection group query, which needs the database-wide wildcard this
       file opens by refusing to have.

       The id is `{by}_{who}`, which the rules never parse. It exists so that
       blocking twice writes the same document rather than a second one, and so
       an unblock has something to address. Ownership is proved by the `by`
       field, not by the id.
       -------------------------------------------------------------------- */
    match /blocks/{blockId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.by == request.auth.uid);

      allow create: if signedIn()
                    && inGoodStanding(request.auth.uid)
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.who is string
                    && request.resource.data.who != request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.at is int
                    && request.resource.data.keys().hasOnly(['by', 'who', 'name', 'at']);

      /* Not edited. Changing who a block is about is making a different block. */
      allow update: if false;

      /* Yours to lift. Blocking is a decision about the future, not a verdict,
         and one somebody has to be able to change their mind about. */
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
